# ============================================================
# Bảy Núi Stay — mẫu biến môi trường
# ============================================================
# Chép file này thành .env rồi điền giá trị thật. KHÔNG bao giờ đưa .env lên
# Git — .gitignore đã chặn sẵn.
#
# Trên máy chủ thật thì không dùng .env mà điền vào /etc/baynuistay.env
# (xem TRIEN_KHAI.md).
# ============================================================

PORT=3000

# Trang được phép gọi API. Thiếu tên miền thật ở đây là trình duyệt chặn hết.
# 10.0.2.2 là localhost của máy tính khi nhìn từ máy ảo Android.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:3000

# ── Nơi cất dữ liệu ──
# Để trống khi chạy ở máy nhà: dùng data/ và public/uploads/ trong dự án.
# Trên máy chủ thật PHẢI trỏ ra ngoài thư mục mã nguồn, không thì mỗi lần cập
# nhật web là hồ sơ đối tác, sổ quỹ và ảnh phòng thật bay theo.
BAYNUI_DATA_DIR=
BAYNUI_UPLOAD_DIR=

# ── Chatbot ──
# Nhiều khoá ngăn cách bằng dấu phẩy; hết lượt khoá này thì tự xoay sang khoá kế.
GEMINI_API_KEYS=
# Lớp dự phòng khi Gemini hết lượt (~20 lượt/ngày/khoá).
# Tên riêng BAYNUI_ vì nhiều máy đã có sẵn biến OPENAI_API_KEY dùng việc khác.
BAYNUI_OPENAI_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Đặt cọc qua chuyển khoản VietQR ──
# BANK_CODE theo chuẩn VietQR: Vietcombank 970436 · MB 970422 · Techcombank 970407
# ACB 970416 · BIDV 970418 · VietinBank 970415 · Agribank 970405 · TPBank 970423
# Để trống thì trang thanh toán nói thẳng "chưa bật", không hiện mã QR hỏng.
BANK_CODE=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=

# Tỉ lệ cọc (0.3 = 30%). Cọc tối thiểu tính bằng đồng.
DEPOSIT_RATE_HOTEL=0.3
DEPOSIT_RATE_TOUR=0.3
DEPOSIT_RATE_TRANSPORT=0.2
DEPOSIT_MIN=50000

# ── Thông báo đẩy (Firebase Cloud Messaging) ──
# Chọn MỘT trong hai cách:
#   Máy nhà    — FCM_SERVICE_ACCOUNT trỏ tới file khoá, hoặc để trống thì tự dò
#                file firebase-adminsdk*.json trong thư mục dự án.
#   Máy chủ    — dán NGUYÊN nội dung file JSON vào FCM_SERVICE_ACCOUNT_JSON,
#                vì máy chủ đám mây chỉ cấp biến môi trường chứ không cho tải
#                file khoá lên.
# Chưa cấu hình thì push tắt, mọi thứ khác vẫn chạy bình thường.
FCM_SERVICE_ACCOUNT=
FCM_SERVICE_ACCOUNT_JSON=

# ── Hộ chiếu Bảy Núi ──
# Bán kính (mét) khách phải đứng trong đó mới đóng được dấu.
PASSPORT_RADIUS_M=600
# Khoá ký mã QR. ĐỔI trước khi in mã ra thực địa — đổi sau là mọi tấm đã in hỏng.
PASSPORT_SECRET=

# ── Cổng thanh toán (điền sau khi có tài khoản merchant) ──
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=
