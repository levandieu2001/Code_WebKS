// ── Tra cứu ──
const findPlace = (slug) => PLACES.find(p => p.slug === slug) || null;
const findTour = (slug) => TOURS.find(t => t.slug === slug) || null;
const findFood = (slug) => FOODS.find(f => f.slug === slug) || null;

module.exports = { PLACES, TOURS, FOODS, findPlace, findTour, findFood };
